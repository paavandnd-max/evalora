# Copy to .env and fill from Supabase Project Settings > API Keys.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me
EVALORA_DEMO_MODE=0
EVALORA_COOKIE_SECURE=0
EVALORA_LOGIN_LIMIT=8
EVALORA_LOGIN_WINDOW_SECONDS=300
EVALORA_SUBMISSION_IP_LIMIT=12
EVALORA_SUBMISSION_WINDOW_SECONDS=600
EVALORA_SUBMISSION_USER_LIMIT=6
EVALORA_SUBMISSION_USER_WINDOW_SECONDS=3600
EVALORA_SUBMISSION_EVENT_LIMIT=500
EVALORA_SUBMISSION_EVENT_WINDOW_SECONDS=3600
EVALORA_SUBMISSION_GLOBAL_LIMIT=2000
EVALORA_SUBMISSION_GLOBAL_WINDOW_SECONDS=3600
EVALORA_EVENT_CREATE_LIMIT=10
EVALORA_EVENT_CREATE_WINDOW_SECONDS=3600
EVALORA_EVENT_CREATE_GLOBAL_LIMIT=100
EVALORA_EVENT_CREATE_GLOBAL_WINDOW_SECONDS=3600
EVALORA_STATEMENT_UPDATE_LIMIT=8
EVALORA_STATEMENT_UPDATE_WINDOW_SECONDS=3600
EVALORA_STAFF_MUTATION_LIMIT=60
EVALORA_STAFF_MUTATION_WINDOW_SECONDS=3600
EVALORA_FILE_UPLOAD_LIMIT=8
EVALORA_FILE_UPLOAD_WINDOW_SECONDS=3600
EVALORA_EVALUATION_LIMIT=8
EVALORA_EVALUATION_WINDOW_SECONDS=300
EVALORA_EVALUATION_EVENT_LIMIT=100
EVALORA_EVALUATION_EVENT_WINDOW_SECONDS=3600
EVALORA_EVALUATION_GLOBAL_LIMIT=500
EVALORA_EVALUATION_GLOBAL_WINDOW_SECONDS=3600
EVALORA_REPORT_LIMIT=40
EVALORA_REPORT_WINDOW_SECONDS=60
